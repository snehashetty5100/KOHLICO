// Prisma Schema — Kohlico Invoice Generation App
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH MODELS (required by NextAuth v4)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  role      String   @default("user") // "admin" | "user"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  invoices Invoice[]

  @@map("users")
}

// ─────────────────────────────────────────────
// CUSTOMERS  (covers both consignee and buyer)
// ─────────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  name          String
  address       String   @db.Text
  country       String
  contactPerson String?
  phone         String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // An invoice references this customer as consignee …
  consigneeInvoices Invoice[] @relation("Consignee")
  // … and optionally as the buyer (notify party).
  buyerInvoices     Invoice[] @relation("Buyer")

  @@map("customers")
}

// ─────────────────────────────────────────────
// PRODUCTS  (reusable product catalogue)
// ─────────────────────────────────────────────

model Product {
  id                 String   @id @default(cuid())
  description        String   // e.g. "ROASTED CHANA W/H SKIN IN POUCH"
  hsCode             String   // e.g. "21069099"
  defaultPackaging   String?  // e.g. "20 X 400 GM"
  defaultRate        Float    // FOB CAD per package (default)
  defaultNetWeight   Float    // kg per package (default)
  defaultGrossWeight Float    // kg per package (default)
  igstRate           Float    @default(0.05) // 5% for exports
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoiceItems InvoiceItem[]

  @@map("products")
}

// ─────────────────────────────────────────────
// INVOICES  (one per export shipment)
// ─────────────────────────────────────────────

model Invoice {
  id              String    @id @default(cuid())
  invoiceNo       String    @unique // e.g. "KF/1902/25-26"
  invoiceDate     DateTime
  proformaInvNo   String?   // optional proforma reference
  proformaDate    DateTime?

  // Exporter legal details (usually company constants, but stored per invoice
  // so historical records are self-contained even if company details change)
  iecCode  String // Importer-Exporter Code
  panNo    String
  gstinNo  String
  endUseCode String? // e.g. "FSH100, GNX100"

  // Parties
  consigneeId String
  consignee   Customer @relation("Consignee", fields: [consigneeId], references: [id])
  buyerId     String?  // null = same as consignee
  buyer       Customer? @relation("Buyer", fields: [buyerId], references: [id])

  // Shipping details
  preCarriage      String  // e.g. "BY SEA"
  portOfReceipt    String  // e.g. "JNPT"
  vesselFlight     String?
  portOfLoading    String  // e.g. "JNPT"
  portOfDischarge  String  // e.g. "VANCOUVER"
  finalDestination String  // e.g. "VANCOUVER"

  countryOfOrigin      String @default("INDIA")
  countryOfDestination String @default("CANADA")

  termsOfDelivery String // e.g. "C & I CAD $ BY SEA"
  exchangeRate    Float  // INR per CAD, e.g. 64.45

  // Totals (some may be derived; stored for historical accuracy on PDF)
  insuranceCAD Float? // overall insurance in CAD (optional)

  status    String   @default("draft") // "draft" | "final"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items InvoiceItem[]

  @@map("invoices")
}

// ─────────────────────────────────────────────
// INVOICE ITEMS  (line items within an invoice)
// ─────────────────────────────────────────────

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String? // optional — allows free-text items with no catalogue product
  product   Product? @relation(fields: [productId], references: [id])

  // Fields on the actual invoice (may differ from product defaults)
  description        String  @db.Text // e.g. "ROASTED CHANA W/H SKIN IN POUCH"
  hsCode             String  // e.g. "21069099"
  packageDescription String  // e.g. "20 X 400 GM"
  marksAndNos        String? // e.g. "KFBPL/VANCOUVER CTNS NO."

  quantity   Int   // number of packages (cartons / bags)
  rate       Float // FOB CAD per package
  fobCAD     Float // = quantity × rate  (stored for immutability)

  netWeight   Float // total net weight for this line (kg)
  grossWeight Float // total gross weight for this line (kg)

  // INR-side calculations (stored for PDF accuracy)
  taxableValueINR Float // = fobCAD × invoice.exchangeRate
  igstRate        Float @default(0.05)
  igstAmountINR   Float // = taxableValueINR × igstRate

  sortOrder Int @default(0) // display order on the invoice

  @@map("invoice_items")
}
